DATABASE_URL=postgresql://localhost/nadha_serve
GEMINI_API_KEY=
# Set this to a structured-output vision model currently supported by your Google AI account.
GEMINI_MODEL=
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=
REQUIRE_REDIS=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@omlu.app
CUSTOMER_PUSH_TTL_SECONDS=43200
REALTIME_MAX_CONNECTIONS=5000
REALTIME_MAX_CONNECTIONS_PER_SESSION=20
REALTIME_MAX_CONNECTIONS_PER_IP=100
FRONTEND_URL=https://omlu.vercel.app
PUBLIC_FRONTEND_URL=https://omlu.vercel.app
# PUBLIC_FRONTEND_URL is also the canonical QR-code base URL.
FRONTEND_URLS=https://omlu.vercel.app,http://localhost:3000,http://127.0.0.1:3000
KITCHEN_API_KEY=replace-with-secure-random-kitchen-api-key
JWT_SECRET_KEY=
# Optional dedicated key for participant-token HMAC and join-code AES-GCM.
# Keep stable across instances. Rotating it invalidates every active participant token
# and makes existing encrypted join codes unrecoverable; rotate active codes afterward.
PARTICIPANT_HMAC_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=480
