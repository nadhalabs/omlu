<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude only secure storage SharedPreferences files for legacy Android backups -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="encrypted_shared_preferences.xml" />
    <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
</full-backup-content>
